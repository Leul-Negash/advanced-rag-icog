# Copy this file to `.env` and fill in ONE provider's key.

# Provider: "groq" (free, fast) or "gemini" (free tier).
LLM_PROVIDER=groq

# Groq - get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# Gemini - get a free key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional overrides (sensible defaults are used if omitted):
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# LLM_MIN_INTERVAL=2.1          # min seconds between LLM calls (free-tier RPM)

# Embedding/reranker models download from Hugging Face on first run.
# This avoids the slow HF-xet transfer path:
HF_HUB_DISABLE_XET=1
